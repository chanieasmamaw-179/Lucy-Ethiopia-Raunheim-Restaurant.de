{
  "version": "1.0.0",
  "scripts": {
    "start": "serve ./"
  },
  "dependencies": {
    "serve": "^14.2.4"
  },
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/about",
      "dest": "/about.html"
    },
    {
      "src": "/contact",
      "dest": "/contact.html"
    }
  ],
  "license": "MIT"
}
